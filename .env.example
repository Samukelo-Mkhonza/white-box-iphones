# Local SQLite database file, used for local dev and `prisma db push`/migrate.
DATABASE_URL="file:./dev.db"

# Hosted libSQL (Turso) database - only needed in deployed environments where
# the filesystem is ephemeral (e.g. Vercel). When set, lib/prisma.ts uses this
# instead of DATABASE_URL. Leave unset for local dev.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Auth (Phase 4)
AUTH_SECRET="change-me"

# PayFast sandbox - https://sandbox.payfast.co.za
# The values below are PayFast's publicly documented sandbox test merchant,
# safe to use as-is for local testing. Replace with real credentials in production.
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="46f0cd694581a"
PAYFAST_PASSPHRASE="jt7NOE43FZPn"
PAYFAST_SANDBOX="true"

# Base URL used for PayFast return/cancel/notify callbacks
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
